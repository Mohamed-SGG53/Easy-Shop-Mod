{
  "schemaVersion": 1,
  "id": "shopmod",
  "version": "${version}",
  "name": "Easy Shop Mod",
  "description": "Adds an NPC that lets you trade whatever you want with other players.",
  "authors": ["MohamedSSG287"],
  "icon": "icon.png",
  "contact": {
    "homepage": "https://modrinth.com/mod/easy-shop-mod"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main":   ["com.example.shopmod.ShopMod"],
    "client": ["com.example.shopmod.ShopModClient"]
  },
  "mixins": [
    "shopmod.mixins.json",
    {"config": "shopmod.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=21",
    "fabric-api": "*"
  }
}
